#CODE
class ElectricBill {
    int units;
    static double fixedCharge = 50;
    public static void main(String[] args) {
        int u = 100;
        double rate = 5;
        ElectricBill e = new ElectricBill();
        e.units = u;
        double bill = (u * rate) + fixedCharge;
        System.out.println("Units: " + e.units);
        System.out.println("Total Bill: " + bill);
    }
}
#OUTPUT
Units: 100
Total Bill: 550.0
