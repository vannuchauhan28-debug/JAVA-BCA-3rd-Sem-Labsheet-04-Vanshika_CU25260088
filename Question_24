#CODE
class Fibonacci {
    static int seriesCount = 0;
    void display(int n) {
        int a = 0, b = 1, c;
        seriesCount++;
        for (int i = 1; i <= n; i++) {
            System.out.print(a + " ");
            c = a + b;
            a = b;
            b = c;
        }
        System.out.println();
    }
    public static void main(String[] args) {
        Fibonacci f = new Fibonacci();
        f.display(7);
        System.out.println("Series Count: " + seriesCount);
    }
}
#OUTPUT
0 1 1 2 3 5 8
Series Count: 1
