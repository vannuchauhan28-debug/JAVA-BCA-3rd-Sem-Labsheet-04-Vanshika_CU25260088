class Palindrome {
    static int countChecks = 0;
    void check(int n) {
        int num = n, rev = 0, rem;
        countChecks++;
        while (num > 0) {
            rem = num % 10;
            rev = rev * 10 + rem;
            num = num / 10;
        }
        if (n == rev)
            System.out.println("Palindrome");
        else
            System.out.println("Not Palindrome");
    }
    public static void main(String[] args) {
        Palindrome p = new Palindrome();
        p.check(121);
        System.out.println("Total Checks: " + countChecks);
    }
}
