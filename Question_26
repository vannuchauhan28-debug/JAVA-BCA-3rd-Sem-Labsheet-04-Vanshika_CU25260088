class Matrix {
    int[][] a = new int[2][2];
    static String matrixType = "2x2 Matrix";
    public static void main(String[] args) {
        int[][] m1 = {{1, 2}, {3, 4}};
        int[][] m2 = {{5, 6}, {7, 8}};
        Matrix m = new Matrix();
        System.out.println("Matrix Type: " + matrixType);
        System.out.println("Addition:");
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++)
                System.out.print((m1[i][j] + m2[i][j]) + " ");
            System.out.println();
        }
        System.out.println("Subtraction:");
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++)
                System.out.print((m1[i][j] - m2[i][j]) + " ");
            System.out.println();
        }
    }
}
